# Auto detect text files and perform LF normalization
* text=auto

# patch-package refuse un patch en CRLF alors que les fichiers vises sont en LF.
# Sans cette regle, un checkout Windows le rend illisible et npm ci echoue.
*.patch text eol=lf
*.diff text eol=lf

# Le script est transféré depuis Windows puis exécuté sur l'hôte Linux Coolify.
scripts/seed-frontend-assets.sh text eol=lf
