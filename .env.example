# Movix frontend (Vite) environment template.
# Copy to .env and fill in real values.

# Core API endpoints
VITE_MAIN_API=
VITE_SITE_URL=
VITE_TMDB_API_KEY=
VITE_WATCHPARTY_API=
VITE_PROXIES_EMBED_API=

# Cloudflare Turnstile (anti-bot)
VITE_TURNSTILE_SITE_KEY=
VITE_TURNSTILE_INVISIBLE_SITEKEY=

# Plus de 10 domaines : un widget gratuit n'en accepte que 10 (chacun couvre
# ses sous-domaines). Créer une nouvelle paire de widgets (un visible, un
# invisible) et la déclarer ici comme groupe numéroté, de 2 à 10. Le groupe 1
# ci-dessus sert tous les domaines qui ne sont listés nulle part.
# L'API doit recevoir la même liste (TURNSTILE_DOMAINS_2… dans
# API/Mainapi/.env.example). Implémentation : src/utils/turnstileKeys.ts.
# Format des domaines : hostnames séparés par des virgules (miroir-a.tld,miroir-b.tld).
VITE_TURNSTILE_DOMAINS_2=
VITE_TURNSTILE_SITE_KEY_2=
VITE_TURNSTILE_INVISIBLE_SITEKEY_2=

# Support
VITE_SUPPORT_TELEGRAM_URL=

# === Analytics ===
# Un seul fournisseur est chargé, choisi ici :
#   "ga"        -> Google Analytics 4 (nécessite VITE_GA_MEASUREMENT_ID)
#   "plausible" -> Plausible          (nécessite VITE_PLAUSIBLE_DOMAIN)
#   "none"      -> aucune mesure, aucun script tiers injecté (défaut)
# Implémentation : src/utils/analytics.ts, appelé depuis src/main.tsx.
# Do Not Track et l'opt-out local (movix_analytics_opt_out=1) coupent la mesure.
VITE_ANALYTICS_PROVIDER=none

# Identifiant de mesure GA4, format G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID=

# Identifiant du site dans le tableau de bord Plausible (ex. movix.fun).
# Le même sur tous les miroirs : un seul dashboard, filtrable par « Hostname ».
VITE_PLAUSIBLE_DOMAIN=

# Hôte du script Plausible : https://plausible.io pour le service hébergé, ou
# l'URL de l'instance auto-hébergée. Vide = https://plausible.io.
VITE_PLAUSIBLE_HOST=

# Chemins du script et de l'API. Les chemins officiels (/js/script*.js et
# /api/event) sont listés dans EasyPrivacy : les bloqueurs les coupent même
# quand ils sont servis depuis un domaine à soi. Un reverse proxy devant
# Plausible peut donc les exposer sous des chemins anodins, déclarés ici :
#   VITE_PLAUSIBLE_SCRIPT_PATH=/assets/vendor.js  -> /js/script.manual.js
#   VITE_PLAUSIBLE_API_PATH=/api/e                -> /api/event
# Vides = chemins officiels (aucun proxy nécessaire).
VITE_PLAUSIBLE_SCRIPT_PATH=
VITE_PLAUSIBLE_API_PATH=

# === Publicité (régie / smartlinks) ===
# Aucune URL de régie n'est en dur dans le code : chaque déploiement met les
# siennes ici. Toutes optionnelles — vides, le site tourne sans pub :
# le popup valide sans ouvrir de fenêtre et la porte SwiftFlux saute l'étape pub.

# Directlinks du popup « Voir une pub » quand les pubs +18 sont actives
# (réglage utilisateur, défaut on). Plusieurs URLs séparées par des virgules :
# elles s'ouvrent toutes dans le même geste (1 fenêtre par URL).
VITE_AD_DIRECT_URLS_ADULT=

# Directlink SFW unique, utilisé quand l'utilisateur a désactivé les pubs +18.
VITE_AD_DIRECT_URL_SFW=

# Script de régie chargé par le popup normal à la place du lien direct
# (src tel que fourni par la régie, souvent protocol-relative : //host/?id=…).
# Vide = mode script coupé, le bouton du popup retombe sur le lien direct.
# Implémentation : src/utils/adScriptMode.ts.
VITE_AD_SCRIPT_SRC=

# Smartlink imposé par le partenaire SwiftFlux (catalogue MP4), ouvert à la
# demande avant la vérification Turnstile. Vide = étape pub sautée.
# Implémentation : src/components/SwiftfluxGate.tsx.
VITE_SWIFTFLUX_AD_URL=

# === Service Worker fallback domain ===
# Liste des miroirs hardcodés au build, utilisés si rentry.co est injoignable.
# Le SW redirigera vers le premier miroir différent de l'origine courante.
# Format : hostnames séparés par virgules (pas de protocole, pas de slash).
VITE_DEFAULT_MIRRORS=movix.health

# URL de la config distante des miroirs. Deux formats acceptés par le SW :
#   - JSON : {"mirrors":["movix.health",...]}  (dpaste.org, gist raw, etc.)
#   - HTML rentry.co/<slug> : hostnames extraits des <a href> du body
# rentry.co/<slug>/raw n'est pas utilisable depuis qu'ils imposent SECRET_RAW_ACCESS_CODE.
VITE_MIRRORS_CONFIG_URL=https://rentry.co/movix

# === Suivi des crashs frontend (GlitchTip, API compatible Sentry) ===
# Remplace l'ancien webhook Discord codé en dur dans ErrorBoundary. Seuls les
# crashs du code Movix sont remontés (ErrorBoundary, exceptions non rattrapées) ;
# le bruit réseau (sources qui tombent, API injoignable, extensions, lecteur
# vidéo) est filtré avant envoi. Voir docs/error-tracking-glitchtip.md.
# Implémentation : src/utils/errorTracking.ts, appelé depuis src/main.tsx.
#
# DSN du projet (Paramètres du projet > Client Keys). Public par conception :
# il ne permet que d'envoyer des événements. Vide = aucun suivi, aucun envoi.
# Rien n'est envoyé depuis `npm run dev`, seulement depuis un build de prod.
VITE_GLITCHTIP_DSN=

# Jeton API GlitchTip : SECRET, sans préfixe VITE_ donc jamais dans le bundle.
# Sert uniquement au build (vite.config.ts) pour envoyer les source maps, puis
# les .map sont supprimés de dist/. Vide = build normal, sans source maps.
# En production, à définir dans les variables d'environnement Cloudflare Pages
# (type « secret »). Un jeton se crée dans GlitchTip > Profil > Auth Tokens.
GLITCHTIP_AUTH_TOKEN=
# Instance GlitchTip : https://app.glitchtip.com (hébergé) ou l'URL de
# l'instance auto-hébergée. Vide = https://app.glitchtip.com.
GLITCHTIP_URL=
# Slugs de l'organisation et du projet GlitchTip qui reçoivent les source maps.
# Vides = movix-frontend / frontend.
GLITCHTIP_ORG=
GLITCHTIP_PROJECT=
